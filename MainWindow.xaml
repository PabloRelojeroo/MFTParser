<Window x:Class="MftParser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MFT Parser" Height="820" Width="1380" MinWidth="900" MinHeight="560"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SidebarButton" Style="{StaticResource BtnGhost}" Content="☰" Padding="9,5" Margin="0,0,12,0" Click="OnSidebar"/>
                    <TextBlock Text="MFT" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text=" Parser" FontSize="16" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    <Border x:Name="VolumeChip" Style="{StaticResource Chip}" Margin="18,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="VolumeText" FontSize="12" Foreground="{DynamicResource Accent}"/>
                    </Border>
                    <Border x:Name="RecordsChip" Style="{StaticResource Chip}" Margin="8,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="RecordsText" FontSize="12" Foreground="{DynamicResource Muted}"/>
                    </Border>
                    <Border x:Name="BootChip" Style="{StaticResource Chip}" Margin="8,0,0,0">
                        <TextBlock x:Name="BootText" FontSize="12" Foreground="{DynamicResource Muted}"/>
                    </Border>
                    <Border x:Name="TimestompChip" Style="{StaticResource Chip}" Margin="8,0,0,0" Visibility="Collapsed"
                            Cursor="Hand" MouseLeftButtonUp="OnTimestompChip">
                        <TextBlock x:Name="TimestompText" FontSize="12" Foreground="{DynamicResource Orange}"/>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Width="290" TextChanged="OnQueryChanged"/>
                    <ComboBox x:Name="VolumeBox" Style="{StaticResource Combo}" Width="96" Margin="8,0,0,0" SelectionChanged="OnVolumePicked">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ShortLabel}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="ParseButton" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="OnParse"/>
                    <Button x:Name="ThemeButton" Style="{StaticResource BtnGhost}" Padding="10,7" Margin="8,0,0,0" Click="OnTheme">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ThemeSwatch" Width="12" Height="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ThemeText" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LanguageButton" Style="{StaticResource BtnGhost}" Padding="10,7" Margin="8,0,0,0" Click="OnLanguage">
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="2" ClipToBounds="True" VerticalAlignment="Center">
                                <Image x:Name="LanguageFlag" Width="20" Height="12" Stretch="Fill"/>
                            </Border>
                            <TextBlock x:Name="LanguageText" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="250" MinWidth="190" MaxWidth="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource Panel}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="18,12,16,18">
                        <CheckBox x:Name="HideNoiseBox" IsChecked="True" Checked="OnToggle" Unchecked="OnToggle"/>
                        <CheckBox x:Name="FoldersBox" Margin="0,12,0,0" Checked="OnToggle" Unchecked="OnToggle"/>
                        <CheckBox x:Name="AdsRowsBox" Margin="0,12,0,0" IsChecked="True" Checked="OnToggle" Unchecked="OnToggle"/>
                        <CheckBox x:Name="UtcBox" Margin="0,12,0,0" IsChecked="True" Checked="OnUtc" Unchecked="OnUtc"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Line}"/>
                    <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0" Padding="0,8,0,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource SideItem}" SelectionChanged="OnCategoryChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{Binding Indent}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" Fill="{Binding Dot}" Visibility="{Binding DotVisibility}"
                                             VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="label" Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="{DynamicResource Muted}"
                                               FontFamily="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                        <Setter TargetName="label" Property="FontSize" Value="11"/>
                                        <Setter TargetName="label" Property="FontWeight" Value="SemiBold"/>
                                        <Setter TargetName="label" Property="Foreground" Value="{DynamicResource Muted}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="SideSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5*" MinHeight="140"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*" MinHeight="170"/>
                </Grid.RowDefinitions>

                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="RangeCaption" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="FromBox" Style="{StaticResource Input}" Width="168" Padding="8,5" FontSize="12"
                                     FontFamily="{StaticResource Mono}" TextChanged="OnRangeTyped"/>
                            <TextBlock Text="→" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBox x:Name="ToBox" Style="{StaticResource Input}" Width="168" Padding="8,5" FontSize="12"
                                     FontFamily="{StaticResource Mono}" TextChanged="OnRangeTyped"/>
                            <RadioButton x:Name="PresetBoot" GroupName="range" Style="{StaticResource Preset}" Margin="10,0,0,0" Checked="OnPreset"/>
                            <RadioButton x:Name="PresetHour" GroupName="range" Style="{StaticResource Preset}" Checked="OnPreset"/>
                            <RadioButton x:Name="PresetDay" GroupName="range" Style="{StaticResource Preset}" Checked="OnPreset"/>
                            <RadioButton x:Name="PresetAll" GroupName="range" Style="{StaticResource Preset}" Checked="OnPreset"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="DateOfText" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,8,0"/>
                            <ComboBox x:Name="FieldBox" Style="{StaticResource Combo}" Width="170" FontSize="12" SelectionChanged="OnFieldChanged"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <DataGrid x:Name="EntriesGrid" Grid.Row="1" SelectionChanged="OnEntrySelected" Sorting="OnSorting"
                          MouseDoubleClick="OnGridDoubleClick" TextBoxBase.TextChanged="OnColumnFilter"
                          ToggleButton.Checked="OnBoolFilter" ToggleButton.Unchecked="OnBoolFilter" ToggleButton.Indeterminate="OnBoolFilter"
                          ContextMenuOpening="OnGridMenu"
                          Background="{StaticResource TleBg}" Foreground="{StaticResource TleText}"
                          FontFamily="{StaticResource TleFont}" FontSize="15"
                          GridLinesVisibility="All" HorizontalGridLinesBrush="{StaticResource TleGrid}"
                          VerticalGridLinesBrush="{StaticResource TleGrid}" MinRowHeight="27"
                          HeadersVisibility="All" RowHeaderWidth="20" EnableColumnVirtualization="False"
                          ColumnHeaderStyle="{StaticResource TleHeaderStyle}" RowStyle="{StaticResource TleRowStyle}"
                          RowHeaderStyle="{StaticResource TleRowHeaderStyle}" CellStyle="{StaticResource TleCellStyle}">
                    <DataGrid.Resources>
                        <Style x:Key="{ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}" TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="{StaticResource TleBg}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="26"/>
                                            </Grid.RowDefinitions>
                                            <Border Background="{StaticResource TleHeader}" BorderBrush="{StaticResource TleHeaderLine}" BorderThickness="0,0,0,1"/>
                                            <Border Grid.Row="1" BorderBrush="{StaticResource TleGrid}" BorderThickness="0,0,0,1">
                                                <Path Data="M0,0 L9,0 L5.5,4 L5.5,8 L3.5,8 L3.5,4 Z" Fill="#5A5A5A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Line" Binding="{Binding Line, Mode=OneWay}" SortMemberPath="Line" Width="64" ElementStyle="{StaticResource CellNumber}"
                                            SortDirection="Ascending"/>
                        <DataGridTemplateColumn Header="Tag" SortMemberPath="Tagged" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource TagCheck}" IsChecked="{Binding Tagged, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Entry Number" Binding="{Binding Index, Mode=OneWay}" SortMemberPath="Index" Width="136" ElementStyle="{StaticResource CellNumber}"/>
                        <DataGridTextColumn Header="Sequence Number" Binding="{Binding Sequence, Mode=OneWay}" SortMemberPath="Sequence" Width="162" ElementStyle="{StaticResource CellNumber}"/>
                        <DataGridTextColumn Header="Parent Entry Number" Binding="{Binding ParentIndex, Mode=OneWay}" SortMemberPath="ParentIndex" Width="198" ElementStyle="{StaticResource CellNumber}"/>
                        <DataGridTextColumn Header="Parent Sequence Number" Binding="{Binding ParentSequence, Mode=OneWay}" SortMemberPath="ParentSequence" Width="226" ElementStyle="{StaticResource CellNumber}"/>
                        <DataGridCheckBoxColumn Header="In Use" Binding="{Binding InUse, Mode=OneWay}" SortMemberPath="InUse" Width="82" ElementStyle="{StaticResource CellCheck}"/>
                        <DataGridTextColumn Header="Parent Path" Binding="{Binding Folder, Mode=OneWay}" SortMemberPath="Folder" Width="450" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="File Name" Binding="{Binding Name, Mode=OneWay}" SortMemberPath="Name" Width="405" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Extension" Binding="{Binding ExtensionText, Mode=OneWay}" SortMemberPath="Extension" Width="116" ElementStyle="{StaticResource CellText}"/>
                        <DataGridCheckBoxColumn Header="Is Directory" Binding="{Binding IsDirectory, Mode=OneWay}" SortMemberPath="IsDirectory" Width="136" ElementStyle="{StaticResource CellCheck}"/>
                        <DataGridCheckBoxColumn Header="Has Ads" Binding="{Binding HasAds, Mode=OneWay}" SortMemberPath="HasAds" Width="91" ElementStyle="{StaticResource CellCheck}"/>
                        <DataGridCheckBoxColumn Header="Is Ads" Binding="{Binding IsAds, Mode=OneWay}" SortMemberPath="IsAds" Width="82" ElementStyle="{StaticResource CellCheck}"/>
                        <DataGridTextColumn Header="File Size" Binding="{Binding Size, Mode=OneWay}" SortMemberPath="Size" Width="110" ElementStyle="{StaticResource CellNumber}"/>
                        <DataGridTextColumn Header="Created0x10" Binding="{Binding Created10, Mode=OneWay}" SortMemberPath="SiCreated" Width="308" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Created0x30" Binding="{Binding Created30, Mode=OneWay}" SortMemberPath="FnCreated" Width="252" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Last Modified0x10" Binding="{Binding Modified10, Mode=OneWay}" SortMemberPath="SiModified" Width="252" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Last Modified0x30" Binding="{Binding Modified30, Mode=OneWay}" SortMemberPath="FnModified" Width="252" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Last Record Change0x10" Binding="{Binding Changed10, Mode=OneWay}" SortMemberPath="SiChanged" Width="252" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Last Record Change0x30" Binding="{Binding Changed30, Mode=OneWay}" SortMemberPath="FnChanged" Width="252" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Last Access0x10" Binding="{Binding Accessed10, Mode=OneWay}" SortMemberPath="SiAccessed" Width="252" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Last Access0x30" Binding="{Binding Accessed30, Mode=OneWay}" SortMemberPath="FnAccessed" Width="252" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Zone Id Contents" Binding="{Binding ZoneIdContents, Mode=OneWay}" SortMemberPath="ZoneIdContents" Width="172" ElementStyle="{StaticResource CellWrap}"/>
                        <DataGridTextColumn Header="Reparse Target" Binding="{Binding ReparseTarget, Mode=OneWay}" SortMemberPath="ReparseTarget" Width="154" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Reference Count" Binding="{Binding LinkCount, Mode=OneWay}" SortMemberPath="LinkCount" Width="163" ElementStyle="{StaticResource CellNumber}"/>
                        <DataGridCheckBoxColumn Header="SI&lt;FN" Binding="{Binding SiLessFn, Mode=OneWay}" SortMemberPath="SiLessFn" Width="127" ElementStyle="{StaticResource CellCheck}"/>
                        <DataGridCheckBoxColumn Header="u Sec Zeros" Binding="{Binding USecZeros, Mode=OneWay}" SortMemberPath="USecZeros" Width="127" ElementStyle="{StaticResource CellCheck}"/>
                        <DataGridCheckBoxColumn Header="Copied" Binding="{Binding Copied, Mode=OneWay}" SortMemberPath="Copied" Width="82" ElementStyle="{StaticResource CellCheck}"/>
                        <DataGridTextColumn Header="Si Flags" Binding="{Binding SiFlags, Mode=OneWay}" SortMemberPath="SiFlags" Width="200" ElementStyle="{StaticResource CellText}" Visibility="Collapsed"/>
                        <DataGridTextColumn Header="Name Type" Binding="{Binding NameTypeText, Mode=OneWay}" SortMemberPath="NameType" Width="120" ElementStyle="{StaticResource CellText}" Visibility="Collapsed"/>
                        <DataGridTextColumn Header="Update Sequence Number" Binding="{Binding Usn, Mode=OneWay}" SortMemberPath="Usn" Width="226" ElementStyle="{StaticResource CellNumber}" Visibility="Collapsed"/>
                        <DataGridTextColumn Header="Logfile Sequence Number" Binding="{Binding Lsn, Mode=OneWay}" SortMemberPath="Lsn" Width="236" ElementStyle="{StaticResource CellNumber}" Visibility="Collapsed"/>
                        <DataGridTextColumn Header="Security Id" Binding="{Binding SecurityId, Mode=OneWay}" SortMemberPath="SecurityId" Width="130" ElementStyle="{StaticResource CellNumber}" Visibility="Collapsed"/>
                        <DataGridTextColumn Header="Object Id File Droid" Binding="{Binding ObjectIdText, Mode=OneWay}" SortMemberPath="ObjectId" Width="340" ElementStyle="{StaticResource CellText}" Visibility="Collapsed"/>
                        <DataGridTextColumn Header="Logged Util Stream" Binding="{Binding LoggedUtilStream, Mode=OneWay}" SortMemberPath="LoggedUtilStream" Width="180" ElementStyle="{StaticResource CellText}" Visibility="Collapsed"/>
                        <DataGridTextColumn Header="Source File" Binding="{Binding SourceFileText, Mode=OneWay}" SortMemberPath="SourceFile" Width="280" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Parse Errors" Binding="{Binding ParseErrors, Mode=OneWay}" SortMemberPath="ParseErrors" Width="150" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Resident Data Decoded" Binding="{Binding ResidentDataDecoded, Mode=OneWay}" SortMemberPath="ResidentDataDecoded" Width="150" ElementStyle="{StaticResource CellText}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>

                <Border Grid.Row="3" Background="{DynamicResource Panel}">
                    <Grid Margin="18,12,18,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Margin="0,0,250,0">
                                <TextBlock x:Name="DetailName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DetailMeta" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"
                                           FontFamily="{StaticResource Mono}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button x:Name="OpenFolderButton" Style="{StaticResource BtnGhost}" Padding="12,5" Click="OnOpenFolder"/>
                                <Button x:Name="CopyButton" Style="{StaticResource BtnGhost}" Padding="12,5" Margin="6,0,0,0" Click="OnCopy"/>
                            </StackPanel>
                        </Grid>

                        <ItemsControl x:Name="ReasonList" Grid.Row="1" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Background}" CornerRadius="4" Padding="8,3" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SummaryTab" GroupName="tabs" Style="{StaticResource Tab}" IsChecked="True" Checked="OnTab"/>
                                <RadioButton x:Name="AttributesTab" GroupName="tabs" Style="{StaticResource Tab}" Checked="OnTab"/>
                                <RadioButton x:Name="StreamsTab" GroupName="tabs" Style="{StaticResource Tab}" Checked="OnTab"/>
                                <RadioButton x:Name="RecordTab" GroupName="tabs" Style="{StaticResource Tab}" Checked="OnTab"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer x:Name="SummaryPane" Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                            <WrapPanel>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Margin="0,0,24,12"
                                        VerticalAlignment="Top">
                                    <Grid x:Name="TimesGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.ColumnSpan="3" Background="{DynamicResource Panel2}" CornerRadius="6,6,0,0"/>
                                        <TextBlock Grid.Column="1" Text="0x10  $STANDARD_INFORMATION" Style="{StaticResource Caption}" Margin="12,7"/>
                                        <TextBlock Grid.Column="2" Text="0x30  $FILE_NAME" Style="{StaticResource Caption}" Margin="12,7"/>
                                    </Grid>
                                </Border>
                                <Grid x:Name="InfoGrid" VerticalAlignment="Top" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </WrapPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="AttributesPane" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      Padding="0,12,0,0" Visibility="Collapsed">
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Top"
                                    HorizontalAlignment="Left" Grid.IsSharedSizeScope="True">
                                <StackPanel>
                                    <Border Background="{DynamicResource Panel2}" CornerRadius="6,6,0,0">
                                        <Grid x:Name="AttributesHeader">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition SharedSizeGroup="a0"/>
                                                <ColumnDefinition SharedSizeGroup="a1"/>
                                                <ColumnDefinition SharedSizeGroup="a2"/>
                                                <ColumnDefinition SharedSizeGroup="a3"/>
                                                <ColumnDefinition SharedSizeGroup="a4"/>
                                                <ColumnDefinition SharedSizeGroup="a5"/>
                                                <ColumnDefinition SharedSizeGroup="a6"/>
                                                <ColumnDefinition SharedSizeGroup="a7"/>
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                    </Border>
                                    <ItemsControl x:Name="AttributeList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource GridLine}" BorderThickness="0,1,0,0">
                                                    <Grid x:Name="row" TextElement.FontFamily="{StaticResource Mono}" TextElement.FontSize="12.5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition SharedSizeGroup="a0"/>
                                                            <ColumnDefinition SharedSizeGroup="a1"/>
                                                            <ColumnDefinition SharedSizeGroup="a2"/>
                                                            <ColumnDefinition SharedSizeGroup="a3"/>
                                                            <ColumnDefinition SharedSizeGroup="a4"/>
                                                            <ColumnDefinition SharedSizeGroup="a5"/>
                                                            <ColumnDefinition SharedSizeGroup="a6"/>
                                                            <ColumnDefinition SharedSizeGroup="a7"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="type" Text="{Binding Type}" Foreground="{DynamicResource Accent}" Margin="12,5"/>
                                                        <TextBlock x:Name="name" Grid.Column="1" Text="{Binding Name}" Margin="12,5"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Stream}" Foreground="{DynamicResource Violet}" Margin="12,5"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Form}" Foreground="{DynamicResource Muted}" Margin="12,5"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding Size}" Margin="12,5" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding Id}" Foreground="{DynamicResource Muted}" Margin="12,5"/>
                                                        <TextBlock Grid.Column="6" Text="{Binding Offset}" Foreground="{DynamicResource Muted}" Margin="12,5"/>
                                                        <TextBlock Grid.Column="7" Text="{Binding Detail}" Margin="12,5"/>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                        <Setter TargetName="type" Property="Margin" Value="28,5,12,5"/>
                                                        <Setter TargetName="type" Property="Foreground" Value="{DynamicResource Muted}"/>
                                                        <Setter TargetName="name" Property="Foreground" Value="{DynamicResource Muted}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="AttributesNote" Foreground="{DynamicResource Muted}" FontSize="12" Margin="12,8" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <ScrollViewer x:Name="StreamsPane" Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,12,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="NoStreamsText" Foreground="{DynamicResource Muted}" FontSize="13"/>
                                <ItemsControl x:Name="StreamList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Border Background="{DynamicResource Panel2}" CornerRadius="6,6,0,0" Padding="10,7">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Meta}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Accent}"
                                                                       FontFamily="{StaticResource Mono}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                    </Border>
                                                    <TextBox Text="{Binding Body, Mode=OneWay}" Style="{StaticResource Code}" BorderThickness="0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid x:Name="RecordPane" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel x:Name="HexLegend" Margin="0,0,0,8"/>
                            <Border Grid.Row="1" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10,8">
                                    <TextBlock x:Name="HexText" FontFamily="{StaticResource Mono}" FontSize="12.5" LineHeight="19"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="StartOverlay" Grid.ColumnSpan="3" Background="{DynamicResource Bg}">
                <Border Width="480" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="10" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="StartTitle" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StartHint" Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,16"/>
                        <ListBox x:Name="VolumeList" Background="Transparent" BorderThickness="0" Padding="0"
                                 MaxHeight="300"
                                 MouseDoubleClick="OnVolumeDoubleClick" SelectionChanged="OnVolumeListChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource VolumeItem}">
                                    <Setter Property="IsEnabled" Value="{Binding IsNtfs}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Drive}" FontFamily="{StaticResource Mono}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Free}" Foreground="{DynamicResource Muted}" FontSize="12"
                                                   FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="StartError" Foreground="{DynamicResource Red}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="OpenFileButton" Style="{StaticResource BtnGhost}" Click="OnOpenFile"/>
                            <Button x:Name="StartButton" Grid.Column="1" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="OnStart"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <Border x:Name="LoadingOverlay" Grid.ColumnSpan="3" Background="{DynamicResource Bg}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                    <TextBlock x:Name="LoadingTitle" FontSize="15" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoadingDetail" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="LoadingBar" Margin="0,14,0,10" Maximum="1"/>
                    <StackPanel x:Name="StepList" HorizontalAlignment="Left" Margin="10,4,0,0">
                        <TextBlock x:Name="StepRead" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,2"/>
                        <TextBlock x:Name="StepPaths" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,2"/>
                        <TextBlock x:Name="StepFlags" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,2"/>
                    </StackPanel>
                    <Button x:Name="CancelButton" Style="{StaticResource BtnGhost}" Padding="12,5" Margin="0,16,0,0"
                            HorizontalAlignment="Center" Click="OnCancel"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" FontSize="12"/>
                <TextBlock x:Name="WarnText" Grid.Column="1" Foreground="{DynamicResource Orange}" FontSize="12" HorizontalAlignment="Right"
                           Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Window>
